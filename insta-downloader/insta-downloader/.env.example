# Copy this file to ".env" and fill in ONLY the provider(s) you are authorised to use.
# Never commit ".env". API keys live on the server only – they are never sent to the browser.

PORT=3000
HOST=0.0.0.0
# Public address of your site (used for canonical URLs, sitemap, Open Graph)
SITE_URL=https://your-domain.com
# Set to 1 when running behind nginx / Cloudflare / a PaaS proxy (so rate-limits see the real IP)
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=20

# auto  = try every configured provider (official Graph API first)
# graph = only the official Instagram API      custom = only your own API below
PROVIDER=auto

# ---------------------------------------------------------------------------
# Provider 1 – OFFICIAL Instagram API (free). Returns videos of the account that owns the token.
#   1. Create a Meta app: https://developers.facebook.com/apps  -> add "Instagram" product
#   2. Add your Instagram professional (Business/Creator) account as a tester and
#      generate a long-lived token with the instagram_business_basic permission.
# ---------------------------------------------------------------------------
IG_ACCESS_TOKEN=
# IG_API_BASE=https://graph.instagram.com/v21.0
# IG_MAX_PAGES=10

# ---------------------------------------------------------------------------
# Provider 2 – OPTIONAL: an authorised HTTP API of YOUR choice (paid or free).
# Nothing is bundled: this stays disabled until CUSTOM_API_URL and CUSTOM_VIDEO_PATH are set.
# Placeholders: {url} = Instagram link (URL-encoded in the URL, raw elsewhere), {shortcode}
# Make sure the service's terms allow your use and that you have the rights to the content.
# ---------------------------------------------------------------------------
CUSTOM_API_URL=
# Example: https://api.example.com/v1/media?url={url}
CUSTOM_API_METHOD=GET
# Example headers (JSON on one line):  {"X-Api-Key":"YOUR_KEY"}
CUSTOM_API_HEADERS=
# For POST: JSON body template, e.g. {"url":"{url}"}
CUSTOM_API_BODY=
# Where to find values in the JSON response. Dot paths; comma = try next if empty.
# Example for {"data":{"medias":[{"url":"https://...mp4"}],"title":"x","thumb":"https://...jpg"}}
CUSTOM_VIDEO_PATH=
CUSTOM_THUMB_PATH=
CUSTOM_TITLE_PATH=

# Contact form messages are appended to this file
# CONTACT_FILE=./data/messages.jsonl
